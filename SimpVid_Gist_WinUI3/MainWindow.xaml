<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpVid_Gist_WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpVid_Gist_WinUI3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SimpVid Gist">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid x:Name="DragAreaGrid" Background="Transparent"/>

            <Grid x:Name="CustomTitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SimpVid Gist" 
                   Margin="16,0,0,0" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center" 
                   IsHitTestVisible="False"/>

                <StackPanel x:Name="RightControlsPanel" 
                    Orientation="Horizontal" 
                    Grid.Column="1" 
                    VerticalAlignment="Center" 
                    Margin="0,0,10,0">
                    <Button x:Name="Button_Save" Content="Save" Click="Button_Save_Click" Background="LightSeaGreen" Foreground="White" CornerRadius="15" Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap">
                    Extract and summarize YouTube video transcripts. Provide an API key to also generate a summary. The default language is English
                </TextBlock>

                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Video URL or ID</TextBlock>
                <TextBox x:Name="UrlTextBox"/>

                <TextBlock Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">AI Base URL (API Endpoint)</TextBlock>
                <TextBox x:Name="BaseUrlTextBox"/>

                <TextBlock Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Model Name</TextBlock>
                <TextBox x:Name="ModelTextBox"/>

                <TextBlock Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">AI API key</TextBlock>
                <PasswordBox x:Name="ApiKeyTextBox" Height="32" PasswordChar="*"/>

                <Button x:Name="SaveButton" 
                        Content="Save AI Base URL and Model Name" 
                        Margin="0,20,0,0" 
                        HorizontalAlignment="Center" 
                        Click="SaveButton_Click"/>

                <Button x:Name="ExtractButton" 
                        Content="Extract Transcript" 
                        Background="SkyBlue" 
                        Foreground="Black"
                        Margin="0,10,0,10" 
                        HorizontalAlignment="Center" 
                        Click="ExtractButton_Click"/>

                <Button x:Name="SummarizeButton" 
                        Content="Summarize Transcript" 
                        Background="Violet" 
                        Foreground="Black"
                        Margin="0,0,0,20" 
                        HorizontalAlignment="Center" 
                        IsEnabled="False" 
                        Click="SummarizeButton_Click"/>

                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="Bold">Transcript</TextBlock>
                <TextBox x:Name="TranscriptTextBox" MinHeight="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,10" TextWrapping="Wrap" FontWeight="Bold">Summary</TextBlock>
                <TextBox x:Name="SummaryTextBox" MinHeight="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>