<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpVid_Gist_WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpVid_Gist_WinUI3"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SimpVid Gist">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid x:Name="DragAreaGrid" Background="Transparent"/>

            <Grid x:Name="CustomTitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="SimpVid Gist" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="v4" Foreground="Gray" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Spacing="8">
                    <Button x:Name="Button_Save" Content="Export" Background="LightSeaGreen" Foreground="White" Height="40" CornerRadius="20" Click="Button_Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" Spacing="10">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray">
                    Extract and summarize YouTube video transcripts.
                </TextBlock>

                <TextBlock Text="Video URL or ID" FontWeight="SemiBold"/>
                <TextBox x:Name="UrlTextBox" TextWrapping="Wrap"/>

                <TextBlock Text="Subtitle Language" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <ComboBox x:Name="LanguageCodeComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="English (en)" Tag="en"/>
                    <ComboBoxItem Content="Simplified Chinese (zh-Hans)" Tag="zh-Hans"/>
                    <ComboBoxItem Content="Traditional Chinese (zh-Hant)" Tag="zh-Hant"/>
                    <ComboBoxItem Content="Japanese (ja)" Tag="ja"/>
                    <ComboBoxItem Content="Korean (ko)" Tag="ko"/>
                    <ComboBoxItem Content="Spanish (es)" Tag="es"/>
                    <ComboBoxItem Content="French (fr)" Tag="fr"/>
                    <ComboBoxItem Content="Russian (ru)" Tag="ru"/>
                </ComboBox>

                <Button x:Name="ExtractButton"
                        Content="Extract Transcript"
                        Background="SkyBlue"
                        Foreground="Black"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Center"
                        Click="ExtractButton_Click"/>

                <TextBlock Text="Transcript" FontWeight="SemiBold"/>
                <TextBox x:Name="TranscriptTextBox" MinHeight="100" MaxHeight="200" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>

                <TextBlock Text="Provide an API key to also generate a summary." TextWrapping="Wrap" Foreground="Gray" Margin="0,20,0,10"/>
                <StackPanel Spacing="10">

                    <TextBlock Text="AI Base URL (API Endpoint)" FontWeight="SemiBold"/>
                    <TextBox x:Name="BaseUrlTextBox" TextWrapping="Wrap"/>

                    <TextBlock Text="Model Name" FontWeight="SemiBold"/>
                    <TextBox x:Name="ModelTextBox" TextWrapping="Wrap"/>

                    <TextBlock Text="AI API key" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ApiKeyTextBox"/>

                    <Button x:Name="SaveButton"
                            Content="Save AI Base URL and Model Name"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Click="SaveButton_Click"/>

                    <Button x:Name="SummarizeButton"
                            Content="Summarize Transcript"
                            Background="Violet"
                            Foreground="Black"
                            Margin="0,5,0,10"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            Click="SummarizeButton_Click"/>

                    <TextBlock Text="Summary" FontWeight="SemiBold"/>
                    <TextBox x:Name="SummaryTextBox" MinHeight="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
